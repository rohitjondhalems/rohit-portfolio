# "Ask about Rohit" chatbot — set these in Vercel → Project → Settings → Environment Variables.
# Neither is required: without keys the bot answers with the best-matching CV passage.

# Primary (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback when Groq is unavailable or rate-limited: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
